---
import "@fontsource/roboto/400.css";
import "@fontsource/roboto/500.css";
import "@fontsource/roboto/700.css";

import { profileConfig, siteConfig } from "@/config";
import ConfigCarrier from "@components/ConfigCarrier.astro";
import FullscreenWallpaper from "@components/wallpaper/FullscreenWallpaper.astro";
import {
	AUTO_MODE,
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	BANNER_HEIGHT_HOME,
	DARK_MODE,
	DEFAULT_THEME,
	LIGHT_MODE,
	PAGE_WIDTH,
} from "../constants/constants";
import { defaultFavicons } from "../constants/icon";
import type { Favicon } from "../types/config";
import { url, pathsEqual } from "../utils/url-utils";
import {
	getWallpaperModeDefault,
	resolveResponsiveImageSource,
} from "../utils/wallpaper-utils";
import "katex/dist/katex.css";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
}

let { title, banner, description, lang, setOGTypeArticle } = Astro.props;

// apply a class to the body element to decide the height of the banner, only used for initial page load
// Swup can update the body for each page visit, but it's after the page transition, causing a delay for banner height change
// so use Swup hooks instead to change the height immediately when a link is clicked
const isHomePage = pathsEqual(Astro.url.pathname, url("/"));

// defines global css variables
// why doing this in Layout instead of GlobalStyles: https://github.com/withastro/astro/issues/6728#issuecomment-1502203757
const configHue = siteConfig.themeColor.hue;
const wallpaperModeDefault = getWallpaperModeDefault(siteConfig);
const wallpaperFeatureEnabled = siteConfig.wallpaper?.enable !== false;
const bannerFeatureEnabled = siteConfig.banner.enable;
const enableFullscreenWallpaper =
	siteConfig.background.enable;
const fullscreenWallpaperFeatureEnabled = siteConfig.background.enable;
const backgroundDesktopSrc =
	resolveResponsiveImageSource(siteConfig.background.src, "desktop") || "";
const backgroundMobileSrc =
	resolveResponsiveImageSource(siteConfig.background.src, "mobile") ||
	backgroundDesktopSrc;
const backgroundBaseSrc = backgroundDesktopSrc || backgroundMobileSrc;
const fullscreenWallpaperOpacity =
	siteConfig.wallpaper?.fullscreen?.opacity ??
	siteConfig.background.opacity ??
	0.3;
const bannerDesktopSrc =
	resolveResponsiveImageSource(siteConfig.banner.src, "desktop") || "";
if (!banner || typeof banner !== "string" || banner.trim() === "") {
	banner = bannerDesktopSrc;
}

// TODO don't use post cover as banner for now
banner = bannerDesktopSrc;

let pageTitle: string;
if (title) {
	pageTitle = `${title} - ${siteConfig.title}`;
} else {
	if (siteConfig.subtitle && siteConfig.subtitle.trim() !== "") {
		pageTitle = `${siteConfig.title} - ${siteConfig.subtitle}`;
	} else {
		pageTitle = siteConfig.title;
	}
}

// Use siteConfig.description as fallback for meta description when no description is provided
if (!description) {
	description = siteConfig.description || pageTitle;
}

const favicons: Favicon[] =
	siteConfig.favicon.length > 0 ? siteConfig.favicon : defaultFavicons;

// const siteLang = siteConfig.lang.replace('_', '-')
if (!lang) {
	lang = `${siteConfig.lang}`;
}
const siteLang = lang.replace("_", "-");

const bannerOffsetByPosition = {
	top: `${BANNER_HEIGHT_EXTEND}vh`,
	center: `${BANNER_HEIGHT_EXTEND / 2}vh`,
	bottom: "0",
};
const bannerOffset =
	bannerOffsetByPosition[siteConfig.banner.position || "center"];

const splashConfig = siteConfig.splash;
const splashEnabled = !!splashConfig?.enable;
const splashAutoCloseMs = splashConfig?.autoCloseMs ?? 1800;
---

<!DOCTYPE html>
    <html lang={siteLang} class="bg-[var(--page-bg)] transition text-[12px] md:text-[16px] dark"  
	  data-overlayscrollbars-initialize>  <!-- 手机端适配 -->

	<head>

		<title>{pageTitle}</title>

		<meta charset="UTF-8" />
		<meta name="description" content={description}>
		<meta name="author" content={profileConfig.name}>
		{siteConfig.keywords && (
			<meta name="keywords" content={siteConfig.keywords.join(", ")}>
		)}

		<meta property="og:site_name" content={siteConfig.title}>
		<meta property="og:url" content={Astro.url}>
		<meta property="og:title" content={pageTitle}>
		<meta property="og:description" content={description}>
		{setOGTypeArticle ? (
        <meta property="og:type" content="article" />
        ) : (
        <meta property="og:type" content="website" />
        )}

		<meta name="twitter:card" content="summary_large_image">
		<meta property="twitter:url" content={Astro.url}>
		<meta name="twitter:title" content={pageTitle}>
		<meta name="twitter:description" content={description}>

		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		{siteConfig.preconnect?.map((href) => (
			<link rel="preconnect" href={href} />
		))}
		<script src="/js/umami-share.js" defer></script>
		<script
			defer
			src="https://umamii.zeabur.app/script.js"
			data-website-id="0e070921-670c-4363-90fb-943fafc9ee2e"
			data-swup-ignore-script
		></script>

		<script data-swup-ignore-script src="https://rapi.0w0.us.ci/random-img-only.js" defer></script>     {/*不用r2的随机图api就注释掉*/}
		<script is:inline define:vars={{ backgroundDesktopSrc, backgroundMobileSrc, enableFullscreenWallpaper }}>
			(function () {
				var manifestCache = null;
				var manifestPromise = null;
				var wallpaperRefreshReloadTriggered = false;
				var modeSwitchRandomCarry = (function () {
					try {
						var raw = sessionStorage.getItem("__wallpaper_random_carry_once__");
						if (!raw) return null;
						sessionStorage.removeItem("__wallpaper_random_carry_once__");
						var parsed = JSON.parse(raw);
						return parsed && typeof parsed === "object" ? parsed : null;
					} catch (_e) {
						return null;
					}
				})();

				function resolveConfiguredBg(url) {
					if (!url) return "";
					if (url === "/random/v") {
						if (modeSwitchRandomCarry && modeSwitchRandomCarry.v) return modeSwitchRandomCarry.v;
						if (window.getRandomPicV) return window.getRandomPicV();
					}
					if (url === "/random/h") {
						if (modeSwitchRandomCarry && modeSwitchRandomCarry.h) return modeSwitchRandomCarry.h;
						if (window.getRandomPicH) return window.getRandomPicH();
					}
					return url;
				}

				function getRandomTypeFromConfiguredUrl(url) {
					if (!url) return "";
					try {
						var parsed = new URL(url, window.location.href);
						if (parsed.pathname === "/random/h") return "h";
						if (parsed.pathname === "/random/v") return "v";
					} catch (_e) {}
					return "";
				}

				function getRandomApiBaseFromGlobal(type) {
					try {
						var fn = type === "v" ? window.getRandomPicV : window.getRandomPicH;
						if (typeof fn !== "function") return "";
						var sample = fn();
						if (!sample) return "";
						return new URL(sample, window.location.href).origin;
					} catch (_e) {
						return "";
					}
				}

				function getManifestUrlForType(type) {
					var base = getRandomApiBaseFromGlobal(type);
					if (base) return base + "/manifest.json";
					return "/manifest.json";
				}

				function loadRandomManifest(type) {
					if (manifestCache) return Promise.resolve(manifestCache);
					if (manifestPromise) return manifestPromise;
					var manifestUrl = getManifestUrlForType(type || "h");
					manifestPromise = fetch(manifestUrl, { cache: "no-store" })
						.then(function (res) {
							if (!res.ok) throw new Error("manifest fetch failed");
							return res.json();
						})
						.then(function (json) {
							manifestCache = json;
							return json;
						})
						.catch(function (_err) {
							manifestPromise = null;
							return null;
						});
					return manifestPromise;
				}

				function triggerWallpaperRefreshReloadFallback() {
					if (wallpaperRefreshReloadTriggered) return;
					wallpaperRefreshReloadTriggered = true;
					window.location.reload();
				}

				function normalizeUrlForCompare(url) {
					if (!url) return "";
					try {
						var u = new URL(url, window.location.href);
						u.search = "";
						u.hash = "";
						return u.toString();
					} catch (_e) {
						return url;
					}
				}

				function chooseDifferentRandomFromList(list, avoidUrl) {
					if (!Array.isArray(list) || list.length === 0) return "";
					if (list.length === 1) return list[0] && list[0].url ? list[0].url : "";
					var avoid = normalizeUrlForCompare(avoidUrl);
					var candidates = list;
					if (avoid) {
						candidates = list.filter(function (item) {
							return item && item.url && normalizeUrlForCompare(item.url) !== avoid;
						});
						if (!candidates.length) candidates = list;
					}
					var picked = candidates[Math.floor(Math.random() * candidates.length)];
					return picked && picked.url ? picked.url : "";
				}

				function resolveConfiguredBgForRefresh(url, currentUrl) {
					var randomType = getRandomTypeFromConfiguredUrl(url);
					if (!randomType) {
						return Promise.resolve(resolveConfiguredBg(url));
					}
					return loadRandomManifest(randomType).then(function (manifest) {
						if (!manifest) {
							// Fallback for random APIs without CORS on manifest.json:
							// preserve "换图按钮" by reloading the page to get a new session random image.
							triggerWallpaperRefreshReloadFallback();
							return "";
						}
						var list = manifest && manifest[randomType];
						var picked = chooseDifferentRandomFromList(list, currentUrl);
						if (picked) return picked;
						return resolveConfiguredBg(url);
					});
				}

				function getBgUrl(isMobile) {
					var configured = isMobile
						? (backgroundMobileSrc || backgroundDesktopSrc)
						: (backgroundDesktopSrc || backgroundMobileSrc);
					return resolveConfiguredBg(configured);
				}

				function getCurrentBgBoxUrl(bgBox) {
					if (!bgBox) return "";
					var inlineBg = bgBox.style.backgroundImage || "";
					var matched = inlineBg.match(/url\((['"]?)(.*?)\1\)/i);
					if (matched && matched[2]) return matched[2];
					var computedBg = window.getComputedStyle(bgBox).backgroundImage || "";
					matched = computedBg.match(/url\((['"]?)(.*?)\1\)/i);
					return matched && matched[2] ? matched[2] : "";
				}

				function applyResponsiveBg(forceNewRandom) {
					if (!enableFullscreenWallpaper) return;
					var bgBox = document.getElementById("bg-box");
					if (!bgBox) return;
					var isMobile =
						window.matchMedia && window.matchMedia("(max-width: 768px)").matches;
					var configured = isMobile
						? (backgroundMobileSrc || backgroundDesktopSrc)
						: (backgroundDesktopSrc || backgroundMobileSrc);
					var applyWithUrl = function (nextUrl) {
						if (!nextUrl) return;
						var img = new Image();
						img.onload = function () {
							bgBox.style.backgroundImage = "url('" + nextUrl + "')";
							bgBox.classList.add("loaded");
						};
						img.src = nextUrl;
					};
					if (forceNewRandom === true) {
						resolveConfiguredBgForRefresh(configured, getCurrentBgBoxUrl(bgBox)).then(applyWithUrl);
						return;
					}
					applyWithUrl(getBgUrl(!!isMobile));
				}

				function preloadAndSwapImageEl(imgEl, nextUrl) {
					if (!imgEl || !nextUrl) return;
					var preload = new Image();
					preload.onload = function () {
						imgEl.src = nextUrl;
					};
					preload.src = nextUrl;
				}

				function refreshBannerImages() {
					var wrapper = document.getElementById("banner-wrapper");
					if (!wrapper) return;
					var desktopConfigured = wrapper.getAttribute("data-banner-src-desktop") || "";
					var mobileConfigured = wrapper.getAttribute("data-banner-src-mobile") || desktopConfigured;

					var desktopImg = document.querySelector("#banner img");
					var mobileImg = document.querySelector("#banner-mobile img");
					var desktopCurrent = desktopImg && desktopImg.getAttribute("src");
					var mobileCurrent = mobileImg && mobileImg.getAttribute("src");

					if (desktopImg) {
						resolveConfiguredBgForRefresh(desktopConfigured, desktopCurrent).then(function (desktopNext) {
							if (desktopNext) preloadAndSwapImageEl(desktopImg, desktopNext);
						});
					}
					if (mobileImg) {
						resolveConfiguredBgForRefresh(mobileConfigured || desktopConfigured, mobileCurrent).then(function (mobileNext) {
							if (mobileNext) preloadAndSwapImageEl(mobileImg, mobileNext);
						});
					}
				}

				function refreshWallpaperNow(mode) {
					var targetMode = mode;
					if (!targetMode || targetMode === "current") {
						targetMode = document.documentElement.getAttribute("data-wallpaper-mode") || "fullscreen";
					}

					if (targetMode === "fullscreen") {
						applyResponsiveBg(true);
						return true;
					}
					if (targetMode === "banner") {
						refreshBannerImages();
						return true;
					}
					return false;
				}

				function debounce(fn, delay) {
					var timer;
					return function () {
						clearTimeout(timer);
						timer = setTimeout(fn, delay);
					};
				}

				var onResize = debounce(applyResponsiveBg, 160);
				window.addEventListener("load", applyResponsiveBg);
				window.addEventListener("resize", onResize);
				document.addEventListener("swup:contentReplaced", applyResponsiveBg);
				if (window.swup && window.swup.hooks) {
					window.swup.hooks.on("content:replace", applyResponsiveBg);
				}

				window.refreshWallpaperNow = refreshWallpaperNow;
				window.prepareWallpaperModeSwitchRandomCarry = function () {
					try {
						var carry = {};
						if (typeof window.getRandomPicH === "function") {
							var h = window.getRandomPicH();
							if (h) carry.h = h;
						}
						if (typeof window.getRandomPicV === "function") {
							var v = window.getRandomPicV();
							if (v) carry.v = v;
						}
						if (carry.h || carry.v) {
							sessionStorage.setItem(
								"__wallpaper_random_carry_once__",
								JSON.stringify(carry),
							);
						}
					} catch (_e) {}
				};
				window.addEventListener("wallpaper:refresh-request", function (event) {
					var mode =
						event && event.detail && typeof event.detail.mode === "string"
							? event.detail.mode
							: "current";
					refreshWallpaperNow(mode);
				});
			})();
		</script>
		
		
		{/* <!-- Content Security Policy -->
		<meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' https://giscus.app https://hpic.072103.xyz https://umami.2x.nz https://hm.baidu.com https://www.googletagmanager.com https://www.google-analytics.com https://pagead2.googlesyndication.com https://googleads.g.doubleclick.net https://static.cloudflareinsights.com https://*.adtrafficquality.google; style-src 'self' 'unsafe-inline' https://giscus.app https://fonts.googleapis.com https://api.iconify.design; font-src 'self' https://fonts.gstatic.com https://api.iconify.design; img-src 'self' data: https: http:; connect-src 'self' https://umami.2x.nz https://hm.baidu.com https://www.google-analytics.com https://analytics.google.com https://api.iconify.design https://static.cloudflareinsights.com https://pic.2x.nz https://q2.qlogo.cn https://ep1.adtrafficquality.google https://googleads.g.doubleclick.net; frame-src 'self' https://giscus.app *.bilibili.com https://www.google.com https://googleads.g.doubleclick.net https://support.nodeget.com https://*.adtrafficquality.google; object-src 'none'; base-uri 'self'; form-action 'self';"> */}
		{favicons.map(favicon => (
			<link rel="icon"
				  href={favicon.src.startsWith('/') ? url(favicon.src) : favicon.src}
				  sizes={favicon.sizes}
				  media={favicon.theme && `(prefers-color-scheme: ${favicon.theme})`}
			/>
		))}

		<script
			is:inline
			define:vars={{
				wallpaperModeDefault,
				wallpaperFeatureEnabled,
				bannerFeatureEnabled,
				fullscreenWallpaperFeatureEnabled,
			}}
		>
			(function () {
				function normalizeWallpaperMode(mode, fallback) {
					if (
						mode === "banner" ||
						mode === "fullscreen" ||
						mode === "none"
					) {
						return mode;
					}
					return fallback;
				}

				function clampWallpaperMode(mode, fallback) {
					if (!wallpaperFeatureEnabled) return "none";
					if (mode === "banner" && !bannerFeatureEnabled) {
						return fullscreenWallpaperFeatureEnabled ? "fullscreen" : "none";
					}
					if (mode === "fullscreen" && !fullscreenWallpaperFeatureEnabled) {
						return bannerFeatureEnabled ? "banner" : "none";
					}
					return normalizeWallpaperMode(mode, fallback);
				}

				var fallbackMode = clampWallpaperMode(
					normalizeWallpaperMode(wallpaperModeDefault, "fullscreen"),
					"fullscreen",
				);
				var storedMode = null;
				try {
					storedMode = localStorage.getItem("wallpaper-mode");
				} catch (_e) {}
				var mode = clampWallpaperMode(storedMode, fallbackMode);

				var root = document.documentElement;
				root.classList.remove(
					"wallpaper-mode-banner",
					"wallpaper-mode-fullscreen",
					"wallpaper-mode-none",
				);
				root.classList.add("wallpaper-mode-" + mode);
				if (mode === "banner") {
					root.classList.add("enable-banner");
				} else {
					root.classList.remove("enable-banner");
				}
				root.setAttribute("data-wallpaper-mode", mode);
			})();
		</script>

		<!-- Set the theme before the page is rendered to avoid a flash -->
		<script is:inline define:vars={{DEFAULT_THEME, LIGHT_MODE, DARK_MODE, AUTO_MODE, BANNER_HEIGHT_EXTEND, PAGE_WIDTH, configHue, forceDarkMode: siteConfig.themeColor.forceDarkMode}}>
			// Force dark mode if configured
			if (forceDarkMode) {
				document.documentElement.classList.add('dark');
				localStorage.setItem('theme', DARK_MODE);
			} else {
				// Load the theme from local storage
			const theme = localStorage.getItem('theme') || DARK_MODE;
			switch (theme) {
				case LIGHT_MODE:
					document.documentElement.classList.remove('dark');
					break
				case DARK_MODE:
					document.documentElement.classList.add('dark');
					break
				case AUTO_MODE:
					if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
						document.documentElement.classList.add('dark');
					} else {
						document.documentElement.classList.remove('dark');
					}
			}
			}

			// Load the hue from local storage
			const hue = localStorage.getItem('hue') || configHue;
			document.documentElement.style.setProperty('--hue', hue);

			// calculate the --banner-height-extend, which needs to be a multiple of 4 to avoid blurry text
			let offset = Math.floor(window.innerHeight * (BANNER_HEIGHT_EXTEND / 100));
			offset = offset - offset % 4;
			document.documentElement.style.setProperty('--banner-height-extend', `${offset}px`);
		</script>

        <style define:vars={{ configHue }}>
            /* Fallback for no-js: Apply default theme hue */
            :root {
                --hue: var(--configHue);
            }
        </style>
		<style is:global define:vars={{
			configHue,
			'page-width': `${PAGE_WIDTH}rem`,
			'bg-url': backgroundBaseSrc ? `url(${backgroundBaseSrc})` : 'none',
			'bg-enable': enableFullscreenWallpaper ? '1' : '0',
			'bg-position': siteConfig.background.position || 'center',
			'bg-size': siteConfig.background.size || 'cover',
			'bg-repeat': siteConfig.background.repeat || 'no-repeat',
			'bg-attachment': siteConfig.background.attachment || 'fixed',
			'bg-opacity': fullscreenWallpaperOpacity.toString()
		}}>
			:root {
				--bg-url: var(--bg-url);
				--bg-enable: var(--bg-enable);
				--bg-position: var(--bg-position);
				--bg-size: var(--bg-size);
				--bg-repeat: var(--bg-repeat);
				--bg-attachment: var(--bg-attachment);
				--bg-opacity: var(--bg-opacity);
			}
			
			/* Background image configuration */
			body {
				--bg-url: var(--bg-url);
				--bg-enable: var(--bg-enable);
				--bg-position: var(--bg-position);
				--bg-size: var(--bg-size);
				--bg-repeat: var(--bg-repeat);
				--bg-attachment: var(--bg-attachment);
				--bg-opacity: var(--bg-opacity);
			}

			#bg-box {
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				background-image: var(--bg-url);
\t\t\t\tbackground-position: var(--bg-position);
				background-size: var(--bg-size);
				background-repeat: var(--bg-repeat);
\t\t\t\tbackground-attachment: var(--bg-attachment);
				opacity: calc(var(--bg-opacity) * var(--bg-enable));
				pointer-events: none;
				z-index: -1;
				transition: opacity 0.3s ease-in-out;
			}
			
			#bg-box.loaded {
				opacity: calc(var(--bg-opacity) * var(--bg-enable));
			}

			:root.wallpaper-mode-banner #bg-box,
			:root.wallpaper-mode-none #bg-box {
				opacity: 0 !important;
			}

			:root.wallpaper-mode-fullscreen #banner-wrapper,
			:root.wallpaper-mode-none #banner-wrapper {
				display: none !important;
			}

			:root.wallpaper-mode-banner #banner-credit,
			:root.wallpaper-mode-fullscreen #banner-credit,
			:root.wallpaper-mode-none #banner-credit {
				transition: opacity 0.2s ease;
			}

			:root.wallpaper-mode-fullscreen #banner-credit,
			:root.wallpaper-mode-none #banner-credit {
				opacity: 0;
				pointer-events: none;
				visibility: hidden;
			}
		</style>

		<style>
			.splash-screen {
				--grid-size: 38px;
				--splash-tint: rgba(0, 0, 0, 0.18);
				position: fixed;
				inset: 0;
				z-index: 9999;
				display: flex;
				align-items: center;
				justify-content: center;
				background-color: var(--page-bg);
				background-image:
					linear-gradient(var(--splash-tint), var(--splash-tint)),
					linear-gradient(
						90deg,
						rgba(0, 0, 0, 0.3) 1px,
						transparent 1px
					),
					linear-gradient(
						rgba(0, 0, 0, 0.3) 1px,
						transparent 1px
					);
				background-repeat: repeat, repeat, repeat;
				background-size:
					100% 100%,
					var(--grid-size) var(--grid-size),
					var(--grid-size) var(--grid-size);
				background-position: center;
				opacity: 0;
				animation: splash-fade-in 0.25s ease forwards;
			}

			:root.dark .splash-screen {
				--splash-tint: rgba(0, 0, 0, 0.45);
				background-image:
					linear-gradient(var(--splash-tint), var(--splash-tint)),
					linear-gradient(
						90deg,
						rgba(255, 255, 255, 0.35) 1px,
						transparent 1px
					),
					linear-gradient(
						rgba(255, 255, 255, 0.35) 1px,
						transparent 1px
					),
					radial-gradient(circle at top, rgba(255, 255, 255, 0.06), transparent 55%);
				background-repeat: repeat, repeat, repeat, no-repeat;
				background-size:
					100% 100%,
					var(--grid-size) var(--grid-size),
					var(--grid-size) var(--grid-size),
					100% 100%;
			}

			.splash-screen.splash-after {
				background-color: transparent;
				background-image:
					linear-gradient(var(--splash-tint), var(--splash-tint)),
					linear-gradient(
						90deg,
						rgba(0, 0, 0, 0.3) 1px,
						transparent 1px
					),
					linear-gradient(
						rgba(0, 0, 0, 0.3) 1px,
						transparent 1px
					);
				background-size:
					100% 100%,
					var(--grid-size) var(--grid-size),
					var(--grid-size) var(--grid-size);
				background-repeat: repeat, repeat, repeat;
				background-position: center;
				transition: background-color 0.4s ease;
			}

			:root.dark .splash-screen.splash-after {
				background-image:
					linear-gradient(var(--splash-tint), var(--splash-tint)),
					linear-gradient(
						90deg,
						rgba(255, 255, 255, 0.35) 1px,
						transparent 1px
					),
					linear-gradient(
						rgba(255, 255, 255, 0.35) 1px,
						transparent 1px
					);
			}

			.splash-screen.splash-exit {
				opacity: 0;
				transition: opacity 0.4s ease;
			}

			.splash-stack {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 0.5rem;
				transition: transform 0.4s ease, gap 0.4s ease;
			}

			.splash-screen.splash-after .splash-stack {
				gap: 0.35rem;
				transform: translateY(-8px);
			}

			.splash-spinner {
				width: 78px;
				height: 78px;
				border: 3px solid var(--primary);
				animation: splash-rotate 1.2s ease-in-out infinite;
				transform-style: preserve-3d;
				will-change: transform;
				transition: opacity 0.2s ease;
			}

			.splash-screen.splash-after .splash-spinner {
				pointer-events: none;
				opacity: 0;
			}

			.splash-profile {
				display: flex;
				flex-direction: column;
				align-items: center;
				width: min(32rem, 90vw);
				gap: 0.6rem;
				opacity: 0;
				transform: translateY(10px);
			}

			.splash-screen.splash-after .splash-profile {
				animation: splash-profile-in 0.6s ease forwards;
				animation-delay: 0.05s;
			}

			.splash-line {
				height: 1px;
				width: 0;
				background: #fff;
				opacity: 0;
				margin: 0.35rem auto;
			}

			.splash-screen.splash-after .splash-line {
				animation: splash-line-in 0.9s cubic-bezier(0.18, 0.66, 0.05, 0.96) forwards;
				animation-delay: 0.2s;
			}

			.splash-screen.splash-after .splash-line:last-child {
				animation-delay: 0.3s;
			}

			.splash-avatar-wrap {
				position: relative;
				width: 84px;
				height: 84px;
				margin-bottom: 0.35rem;
			}

			.splash-avatar-glow {
				position: absolute;
				inset: -10px;
				border-radius: 999px;
				background: radial-gradient(circle, rgba(255, 255, 255, 0.7), transparent 70%);
				filter: blur(14px);
				opacity: 0.35;
			}

			:root.dark .splash-avatar-glow {
				background: radial-gradient(circle, rgba(255, 255, 255, 0.35), transparent 70%);
			}

			.splash-avatar {
				position: relative;
				width: 100%;
				height: 100%;
				border-radius: 999px;
				border: 2px solid rgba(255, 255, 255, 0.8);
				background: var(--card-bg);
				box-shadow: 0 12px 25px rgba(0, 0, 0, 0.2);
				object-fit: cover;
			}

			:root.dark .splash-avatar {
