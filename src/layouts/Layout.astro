			}

			.splash-author-name {
				font-size: 1.05rem;
				font-weight: 700;
				letter-spacing: 0.08em;
				color: rgba(255, 255, 255, 0.9);
				text-align: center;
			}

			.splash-site-title {
				font-size: clamp(1.05rem, 1.6vw + 0.4rem, 1.45rem);
