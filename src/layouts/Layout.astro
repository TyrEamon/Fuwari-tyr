			<!-- increase the page height during page transition to prevent the scrolling animation from jumping -->
			<div id="page-height-extend" class="hidden h-[300vh]"></div>
		</div>

		<script is:inline define:vars={{ splashEnabled, splashAutoCloseMs }}>
			(function () {
				if (!splashEnabled) return;
				var overlay = document.getElementById("splash-screen");
				if (!overlay) return;
				var spinner = overlay.querySelector(".splash-spinner");
				var closed = false;
				var phase2Started = false;
				var spinCycleMs = 1200;
				var minSpinMs = 1800;
				var phase2FallbackMs = minSpinMs + spinCycleMs + 200;

				function startPhase2() {
					if (closed || phase2Started || !overlay) return;
					phase2Started = true;
					overlay.classList.add("splash-after");
				}

				function closeSplash() {
					if (closed) return;
					closed = true;
					if (overlay) overlay.classList.add("splash-exit");
					document.body.classList.remove("splash-active");
					document.body.classList.add("splash-done");
					setTimeout(function () {
						if (overlay) overlay.remove();
					}, 450);
				}

				var phase2MinReached = false;
				setTimeout(function () {
					phase2MinReached = true;
				}, minSpinMs);

				if (spinner) {
					spinner.addEventListener("animationiteration", function () {
						if (phase2MinReached) {
							startPhase2();
						}
					});
				}

				setTimeout(startPhase2, phase2FallbackMs);

				function closeByWheelOrTouch() {
					if (!overlay || !overlay.classList.contains("splash-after")) return;
					closeSplash();
				}

				overlay.addEventListener("click", closeSplash);
				window.addEventListener("wheel", closeByWheelOrTouch, { passive: true });
				window.addEventListener("touchstart", closeByWheelOrTouch, { passive: true });
				if (splashAutoCloseMs && splashAutoCloseMs > 0) {
					setTimeout(closeSplash, splashAutoCloseMs);
				}
			})();
		</script>

		
	</body>
</html>

