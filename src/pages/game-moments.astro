---
import { Icon } from "astro-icon/components";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import BackToExhibitionChip from "@components/misc/BackToExhibitionChip.astro";
---

<MainGridLayout title="游戏时刻" description="精彩瞬间与片段记录">
	<div class="card-base p-6 md:p-8">
		<div class="mb-4">
			<BackToExhibitionChip />
		</div>
		<div class="flex items-center gap-3 mb-4">
			<div class="h-10 w-10 rounded-lg bg-[var(--primary)]/15 text-[var(--primary)] flex items-center justify-center">
				<Icon name="material-symbols:sports-esports-rounded" class="text-[1.5rem]" />
			</div>
			<div>
				<h1 class="text-2xl font-bold text-90">游戏时刻</h1>
				<p class="text-sm text-50">发布记录游戏里的精彩瞬间</p>
			</div>
		</div>

		<div class="rounded-xl border border-[var(--line-divider)] bg-[var(--card-bg)] p-5 text-sm text-60">
			页面已预留。后续可以整理高光截图、战绩记录、整活瞬间或短视频外链。
		</div>
	</div>
</MainGridLayout>
