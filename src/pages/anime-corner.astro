---
import { Icon } from "astro-icon/components";
import MainGridLayout from "@layouts/MainGridLayout.astro";
---

<MainGridLayout title="动漫角" description="动漫 / 电影 / 观后感">
	<div class="card-base p-6 md:p-8">
		<div class="flex items-center gap-3 mb-4">
			<div class="h-10 w-10 rounded-lg bg-[var(--primary)]/15 text-[var(--primary)] flex items-center justify-center">
				<Icon name="material-symbols:movie-rounded" class="text-[1.5rem]" />
			</div>
			<div>
				<h1 class="text-2xl font-bold text-90">动漫角</h1>
				<p class="text-sm text-50">上传看过的动漫、电影与一些观后感</p>
			</div>
		</div>

		<div class="rounded-xl border border-[var(--line-divider)] bg-[var(--card-bg)] p-5 text-sm text-60">
			页面已预留。后续可以整理追番记录、电影清单、短评、长评与截图片段。
		</div>
	</div>
</MainGridLayout>
