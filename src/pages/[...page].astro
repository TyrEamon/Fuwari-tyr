---
import type { GetStaticPaths } from "astro";
import PostPage from "../components/PostPage.astro";
import Pagination from "../components/control/Pagination.astro";
import { PAGE_SIZE } from "../constants/constants";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { getSortedPosts } from "../utils/content-utils";

export const getStaticPaths = (async ({ paginate }) => {
	const allBlogPosts = await getSortedPosts();
	return paginate(allBlogPosts, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;
// https://github.com/withastro/astro/issues/6507#issuecomment-1489916992

const { page } = Astro.props;

const len = page.data.length;
---

<MainGridLayout title={page.currentPage === 1 ? undefined : `第${page.currentPage}页`}>
	{page.currentPage === 1 && (
		<section
			data-hitokoto-card
			class="card-base no-hue-rotate onload-animation mb-4 px-6 py-3 text-center"
			style="animation-delay: calc(var(--content-delay) + 80ms); border: 3px solid var(--primary);"
		>
			<div class="mt-1 text-lg font-semibold text-[var(--primary)] leading-relaxed">
				<span data-hitokoto-text>
					黑夜再长也挡不住点亮的那一刻“执念”
				</span>
				<span
					data-hitokoto-meta
					class="ml-1 text-sm font-normal tracking-normal text-black/55 dark:text-white/55"
				></span>
			</div>
		</section>
	)}
	{page.currentPage === 1 && (
		<script is:inline>
			(() => {
				const API = "https://v1.hitokoto.cn/?encode=json";

				function getCard() {
					return document.querySelector("[data-hitokoto-card]");
				}

				async function loadHitokoto() {
					const card = getCard();
					if (!(card instanceof HTMLElement)) return;
					if (card.dataset.loading === "1") return;

					const textEl = card.querySelector("[data-hitokoto-text]");
					const metaEl = card.querySelector("[data-hitokoto-meta]");
					if (!(textEl instanceof HTMLElement) || !(metaEl instanceof HTMLElement)) return;

					card.dataset.loading = "1";
					try {
						const res = await fetch(API, {
							headers: { Accept: "application/json" },
						});
						if (!res.ok) throw new Error(`HTTP ${res.status}`);
						const data = await res.json();

						if (typeof data?.hitokoto === "string" && data.hitokoto.trim()) {
							textEl.textContent = data.hitokoto.trim();
						}

						const fromParts = [data?.from_who, data?.from].filter(
							(v) => typeof v === "string" && v.trim(),
						);
						metaEl.textContent = fromParts.length > 0 ? `—— ${fromParts.join(" · ")}` : "";
					} catch (_err) {
						metaEl.textContent = "";
					} finally {
						card.dataset.loading = "0";
					}
				}

				function runOnHomeCard() {
					if (!getCard()) return;
					void loadHitokoto();
				}

				runOnHomeCard();

				if (window.__hitokotoHomeCardBound) return;
				window.__hitokotoHomeCardBound = true;
				document.addEventListener("swup:contentReplaced", runOnHomeCard);
				document.addEventListener("astro:page-load", runOnHomeCard);
			})();
		</script>
	)}
	{page.currentPage === 1 && (
		<script is:inline>
			(() => {
				const CARD_SELECTOR = "[data-top-wallpaper-card-cover] img";
				const TRANSPARENT_GIF =
					"data:image/gif;base64,R0lGODlhAQABAAAAACwAAAAAAQABAAA=";

				function normalizeUrl(url) {
					if (!url || typeof url !== "string") return "";
					const trimmed = url.trim();
					if (!trimmed) return "";
					if (
						trimmed === TRANSPARENT_GIF ||
						trimmed.includes("/random/h") ||
						trimmed.includes("/random/v")
					) {
						return "";
					}
					return trimmed;
				}

				function getUrlFromBgBox() {
					const bg = document.getElementById("bg-box");
					if (!(bg instanceof HTMLElement)) return "";
					const value =
						bg.style.backgroundImage || getComputedStyle(bg).backgroundImage || "";
					const m = value.match(/url\((['"]?)(.*?)\1\)/i);
					return normalizeUrl(m?.[2] || "");
				}

				function getUrlFromBanner() {
					const mobile = document.querySelector("#banner-mobile img");
					const desktop = document.querySelector("#banner img");
					const mobileVisible =
						mobile instanceof HTMLImageElement &&
						getComputedStyle(mobile).display !== "none";
					if (mobileVisible) return normalizeUrl(mobile.getAttribute("src") || mobile.src || "");
					if (desktop instanceof HTMLImageElement) {
						return normalizeUrl(desktop.getAttribute("src") || desktop.src || "");
					}
					return "";
				}

				function getCurrentWallpaperUrl(explicitUrl) {
					const fromEvent = normalizeUrl(explicitUrl || "");
					if (fromEvent) return fromEvent;
					const lastApplied = normalizeUrl(window.__lastAppliedWallpaperUrl || "");
					if (lastApplied) return lastApplied;
					const mode = document.documentElement.getAttribute("data-wallpaper-mode");
					if (mode === "banner") return getUrlFromBanner();
					if (mode === "fullscreen") return getUrlFromBgBox();
					return getUrlFromBanner() || getUrlFromBgBox();
				}

				function syncTopCardCover(explicitUrl) {
					const img = document.querySelector(CARD_SELECTOR);
					if (!(img instanceof HTMLImageElement)) return;
					const nextUrl = getCurrentWallpaperUrl(explicitUrl);
					if (!nextUrl) return;
					const current = img.currentSrc || img.src || img.getAttribute("src") || "";
					if (current === nextUrl) return;

					const preload = new Image();
					preload.onload = () => {
						img.src = nextUrl;
						img.alt = "Cover Image of the Post";
						img.dataset.wallpaperSynced = "1";
					};
					preload.src = nextUrl;
				}

				function scheduleSync() {
					[0, 120, 500, 1200, 2500].forEach((delay) =>
						setTimeout(() => syncTopCardCover(), delay),
					);
				}

				function onWallpaperApplied(event) {
					const url = event?.detail?.url;
					syncTopCardCover(url);
				}

				function run() {
					if (!document.querySelector(CARD_SELECTOR)) return;
					scheduleSync();
				}

				run();

				if (window.__topCardWallpaperSyncBound) return;
				window.__topCardWallpaperSyncBound = true;
				document.addEventListener("swup:contentReplaced", run);
				document.addEventListener("astro:page-load", run);
				document.addEventListener("wallpaper:mode-change", scheduleSync);
				window.addEventListener("resize", scheduleSync, { passive: true });
				window.addEventListener("wallpaper:applied", onWallpaperApplied);
				window.addEventListener("random-pic-api:ready", scheduleSync);
			})();
		</script>
	)}
	<PostPage page={page}></PostPage>
	<Pagination class="mx-auto onload-animation" page={page} style={`animation-delay: calc(var(--content-delay) + ${len * 50}ms)`}></Pagination>
</MainGridLayout>
