---
import { Icon } from "astro-icon/components";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import BackToExhibitionChip from "@components/misc/BackToExhibitionChip.astro";
import { url } from "@/utils/url-utils";

const navChipClass =
	"inline-flex items-center gap-2 rounded-full border border-[var(--line-divider)] bg-[var(--card-bg)] px-3 py-1.5 text-[11px] md:text-xs font-medium text-70 transition hover:-translate-y-px hover:border-[var(--primary)]/35 hover:bg-[var(--btn-plain-bg-hover)] hover:text-[var(--primary)] active:translate-y-0";

const docs = [
	{
		title: "Shortlink Generator Docs",
		description: "Example tool documentation page under /src/pages/tools-docs.",
		url: "/tools-docs/shortlink/",
		icon: "fa6-solid:link",
	},
];
---

<MainGridLayout title="Tools Docs" description="Tool documentation pages that do not enter the homepage post feed.">
	<section class="card-base p-6 md:p-8 space-y-5">
		<div class="flex flex-wrap items-center gap-3">
			<BackToExhibitionChip />
			<a
				href={url("/toolbox/")}
				class={navChipClass}
			>
				<span class="inline-flex h-4 w-4 items-center justify-center text-[var(--primary)]">
					<Icon name="fa6-solid:toolbox" class="text-[0.68rem]" />
				</span>
				Back to Toolbox
			</a>
		</div>

		<div>
			<h1 class="text-2xl md:text-3xl font-bold text-90">Tools Docs</h1>
			<p class="mt-2 text-sm md:text-base text-60">
				Pages under <code>/src/pages/tools-docs/</code> are regular routes. They are useful for tool manuals and notes, and they do not show up in the homepage post list.
			</p>
		</div>

		<div class="grid gap-4 md:grid-cols-2">
			{docs.map((doc) => (
				<a
					href={url(doc.url)}
					class="group card-base rounded-xl p-4 border border-[var(--line-divider)] transition hover:-translate-y-0.5 hover:border-[var(--primary)]/35"
				>
					<div class="flex items-start gap-3">
						<div class="h-10 w-10 rounded-lg bg-[var(--primary)]/12 text-[var(--primary)] flex items-center justify-center shrink-0">
							<Icon name={doc.icon} class="text-lg" />
						</div>
						<div class="min-w-0">
							<div class="flex items-center gap-2">
								<h2 class="text-base font-semibold text-90 group-hover:text-[var(--primary)] transition">
									{doc.title}
								</h2>
								<Icon name="fa6-solid:arrow-right" class="text-xs text-50" />
							</div>
							<p class="mt-1 text-sm text-60">{doc.description}</p>
						</div>
					</div>
				</a>
			))}
		</div>
	</section>
</MainGridLayout>
