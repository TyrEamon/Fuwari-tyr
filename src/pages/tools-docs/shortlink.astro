---
import { Icon } from "astro-icon/components";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import BackToExhibitionChip from "@components/misc/BackToExhibitionChip.astro";
import { url } from "@/utils/url-utils";

const navChipClass =
	"inline-flex items-center gap-2 rounded-full border border-[var(--line-divider)] bg-[var(--card-bg)] px-3 py-1.5 text-[11px] md:text-xs font-medium text-70 transition hover:-translate-y-px hover:border-[var(--primary)]/35 hover:bg-[var(--btn-plain-bg-hover)] hover:text-[var(--primary)] active:translate-y-0";
---

<MainGridLayout title="Shortlink Generator Docs" description="Example docs page under /tools-docs/">
	<article class="card-base p-6 md:p-8 space-y-6">
		<div class="flex flex-wrap items-center gap-3">
			<BackToExhibitionChip />
			<a
				href={url("/toolbox/")}
				class={navChipClass}
			>
				<span class="inline-flex h-4 w-4 items-center justify-center text-[var(--primary)]">
					<Icon name="fa6-solid:toolbox" class="text-[0.68rem]" />
				</span>
				Back to Toolbox
			</a>
			<a
				href={url("/tools-docs/")}
				class={navChipClass}
			>
				<span class="inline-flex h-4 w-4 items-center justify-center text-[var(--primary)]">
					<Icon name="fa6-solid:book" class="text-[0.68rem]" />
				</span>
				Tools Docs Index
			</a>
		</div>

		<header class="space-y-2">
			<div class="inline-flex items-center gap-2 rounded-full bg-[var(--primary)]/10 px-3 py-1 text-xs font-medium text-[var(--primary)]">
				<Icon name="fa6-solid:link" class="text-xs" />
				Tool Documentation Example
			</div>
			<h1 class="text-2xl md:text-3xl font-bold text-90">Shortlink Generator Docs</h1>
			<p class="text-sm md:text-base text-60">
				This is a sample page under <code>/src/pages/tools-docs/</code>. It is useful for tool usage notes and deployment docs without entering the homepage article feed.
			</p>
		</header>

		<section class="space-y-3">
			<h2 class="text-lg font-semibold text-90">When to use this route type</h2>
			<ul class="list-disc pl-5 text-sm text-70 space-y-1">
				<li>Tool usage instructions</li>
				<li>Deployment notes for a single utility page</li>
				<li>Internal docs you do not want listed on the homepage</li>
			</ul>
		</section>

		<section class="space-y-3">
			<h2 class="text-lg font-semibold text-90">Where homepage posts should still be written</h2>
			<div class="rounded-xl border border-[var(--line-divider)] bg-[var(--card-bg)] p-4 text-sm text-70">
				Write homepage-visible blog posts in <code>src/content/posts/*.md</code>.<br />
				Write toolbox-only docs pages in <code>src/pages/tools-docs/*</code>.
			</div>
		</section>

		<section class="space-y-3">
			<h2 class="text-lg font-semibold text-90">Example links</h2>
			<div class="flex flex-wrap gap-3">
				<a
					href={url("/toolbox/")}
					class="inline-flex items-center gap-2 rounded-lg border border-[var(--primary)]/30 bg-[var(--primary)]/10 px-3 py-2 text-sm font-medium text-[var(--primary)] transition hover:bg-[var(--primary)]/15"
				>
					<Icon name="fa6-solid:toolbox" class="text-xs" />
					Toolbox
				</a>
				<a
					href={url("/posts/openlist-theme/")}
					class="inline-flex items-center gap-2 rounded-lg border border-[var(--line-divider)] bg-[var(--card-bg)] px-3 py-2 text-sm font-medium text-70 transition hover:text-[var(--primary)]"
				>
					<Icon name="fa6-solid:file-lines" class="text-xs" />
					A homepage post example
				</a>
			</div>
		</section>
	</article>
</MainGridLayout>
